#!/usr/bin/env python3
"""List existing file paths on the visible Herdr tab for Vellum."""

import json
import os
import re
import subprocess
import sys
from functools import lru_cache

TOKEN = re.compile(r"[^\s<>\"'`]+")
QUOTED = re.compile(r"`([^`]+)`|\"([^\"]+)\"")
LINE_NUMBER = re.compile(r"^(.*?)(:\d+(?::\d+|[-–—]\d+)?)$")
LINE_NUMBER_CONTINUATION = re.compile(r"^(?!\d+[.)](?:\s|$))\d+(?::\d+|[-–—]\d+)?(?=$|[\s.,;!?)\]}\"'`])")
MAX_WRAP_ROWS = 8


@lru_cache(maxsize=32)
def project_files(cwd):
    """Index tracked and non-ignored untracked files once per pane directory."""
    try:
        root = subprocess.check_output(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
        files = subprocess.check_output(
            ["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            text=True, stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return {}
    by_name = {}
    for relative in dict.fromkeys(files.split("\0")):
        if relative:
            by_name.setdefault(os.path.basename(relative), []).append(os.path.join(root, relative))
    return by_name


def herdr(*args):
    return subprocess.check_output(
        [os.environ.get("HERDR_BIN_PATH", "herdr"), *args], text=True
    )


def pane_title(pane):
    return pane.get("label") or pane.get("agent") or pane.get("terminal_title_stripped") or "󰆍 terminal"


def paths_in(text, cwd, width):
    lines = text.splitlines()
    for index, line in enumerate(lines):
        joined = line.rstrip()
        row = index
        wrapped = []
        while row < index + MAX_WRAP_ROWS and row + 1 < len(lines) and (
            len(lines[row].rstrip()) >= width - 4 or lines[row].rstrip().endswith("/")
            # Text renderers can wrap before the pane edge because of padding.
            or (
                lines[row].rstrip().endswith(":")
                and LINE_NUMBER_CONTINUATION.match(lines[row + 1].lstrip())
            )
        ):
            joined += lines[row + 1].lstrip()
            wrapped.append(joined)
            row += 1
        # Prefer complete wrapped references over a path without its range.
        for candidate in [*reversed(wrapped), line]:
            yield from paths_on_line(candidate, cwd)


def paths_on_line(text, cwd):
    quoted = [match.group(1) or match.group(2) for match in QUOTED.finditer(text)]
    for token in [*quoted, *(match.group() for match in TOKEN.finditer(text))]:
        token = token.strip("([{,;:!?)]}")
        token = token.rstrip(".,;:!?)").lstrip("@")
        if "://" in token:
            continue
        numbered = LINE_NUMBER.match(token)
        display = numbered.group(1) if numbered else token
        if not display or display.startswith(("-", "#")):
            continue
        path = os.path.abspath(os.path.join(cwd, os.path.expanduser(display)))
        if not os.path.isfile(path) and display.endswith("*"):
            # ls -F marks executable files with *, but * may also be a real filename character.
            display = display[:-1]
            token = token[:-1]
            path = os.path.abspath(os.path.join(cwd, os.path.expanduser(display)))
        if os.path.isfile(path):
            yield path, token
        elif os.path.basename(display) == display and "." in display:
            # Agent prose often names a nested project file without its directory.
            suffix = numbered.group(2) if numbered else ""
            for found in project_files(cwd).get(display, []):
                if os.path.isfile(found):
                    yield found, os.path.relpath(found, os.path.realpath(cwd)) + suffix


def main():
    pane_id = os.environ.get("HERDR_ACTIVE_PANE_ID") or os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        sys.exit("No active Herdr pane")
    layout = json.loads(herdr("pane", "layout", "--pane", pane_id))["result"]["layout"]
    panes = json.loads(herdr("pane", "list", "--workspace", layout["workspace_id"]))["result"]["panes"]
    details = {pane["pane_id"]: pane for pane in panes}
    files = []
    seen = set()
    for pane in layout["panes"]:
        if layout["zoomed"] and not pane["focused"]:
            continue
        info = details[pane["pane_id"]]
        text = herdr("pane", "read", pane["pane_id"], "--source", "visible", "--format", "text")
        for path, display in paths_in(text, info.get("foreground_cwd") or info["cwd"], pane["rect"]["width"]):
            numbered = LINE_NUMBER.match(display)
            reference = path + (numbered.group(2) if numbered else "")
            if reference not in seen:
                seen.add(reference)
                files.append({"path": path, "reference": reference, "display_path": display, "pane_title": pane_title(info)})
    json.dump(files, sys.stdout)
    print()


if __name__ == "__main__":
    main()
