#!/usr/bin/env zsh
set -euo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/television"
cache_file="$cache_dir/gh-repo-list-v3.txt"
ttl_seconds=300

mkdir -p "$cache_dir"

if [[ -f "$cache_file" ]]; then
  now=$(date +%s)
  mtime=$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null || print 0)
  age=$((now - mtime))

  if (( age < ttl_seconds )); then
    cat "$cache_file"
    exit 0
  fi
fi

tmp_file="$cache_file.tmp.$$"
trap 'rm -f "$tmp_file"' EXIT INT TERM

if gh api --paginate --method GET user/repos \
  -f affiliation=owner,organization_member \
  -f per_page=100 \
  --jq '.[] | [.full_name, ("\u001b[38;5;250m" + (.description // "") + "\u001b[0m")] | @tsv' \
  >"$tmp_file"; then
  mv "$tmp_file" "$cache_file"
  cat "$cache_file"
  exit 0
fi

if [[ -f "$cache_file" ]]; then
  cat "$cache_file"
  exit 0
fi

exit 1
