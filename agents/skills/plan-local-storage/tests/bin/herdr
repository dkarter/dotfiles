#!/usr/bin/env zsh
set -euo pipefail

state_dir="${FAKE_HERDR_STATE:?}"
print -r -- "${(j: :)@}" >>"$state_dir/calls"

case "$1 $2" in
  'pane list') <"$state_dir/panes.json" ;;
  'pane process-info')
    pane_key="${4//:/_}"
    <"$state_dir/process-$pane_key.json"
    ;;
  'pane current')
    print -r -- '{"result":{"pane":{"workspace_id":"w1","tab_id":"w1:t1","pane_id":"w1:p1"}}}'
    ;;
  'pane send-text')
    if [[ ${FAKE_HERDR_FAIL_SEND:-} == 1 ]]; then
      exit 41
    fi
    print -r -- "$4" >"$state_dir/sent-text"
    ;;
  'pane send-keys') ;;
  'pane split')
    print -r -- '{"result":{"pane":{"workspace_id":"w1","tab_id":"w1:t1","pane_id":"w1:pnew"}}}'
    ;;
  'pane run')
    print -r -- "$4" >"$state_dir/run-command"
    ;;
  *) exit 64 ;;
esac
