amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Settings live in .github/jactionlint.yaml (online checks, immutable-release pins).
local jactionlint = new Step {
  glob = List(
    ".github/workflows/*.yaml",
    ".github/workflows/*.yml",
    ".github/dependabot.y*ml",
    "**/action.yml",
    "**/action.yaml"
  )
  batch = true
  diagnostic_format = "sarif"
  check = "jactionlint --format sarif {{files}}"
  check_diff = "hk util sarif-diff -- jactionlint --format sarif {{files}}"
  fix = "jactionlint --fix {{files}}"
}

hooks {
  ["check"] {
    steps {
      ["dprint"] = Builtins.dprint
      ["jactionlint"] = jactionlint
    }
  }

  ["fix"] {
    fix = true
    steps {
      ["dprint"] = Builtins.dprint
      ["jactionlint"] = jactionlint
    }
  }

  ["pre-commit"] {
    steps {
      ["betterleaks"] {
        check = new CommandSpec {
          command = "betterleaks git --pre-commit --staged --redact --verbose --no-banner --validation=false"
          effect = "read"
        }
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commits"] {
        check = "committed --commit-file {{ commit_msg_file }}"
      }
    }
  }

  ["pre-push"] {
    steps {
      ["checks"] {
        check = "hk check --all"
      }
    }
  }
}
