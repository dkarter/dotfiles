amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local typos = new Step {
  exclude = ".codespellignorelines"
  check = new CommandSpec {
    effect = "read"
    command = """
    set --
    for file in {{files}}; do
      [ ! -e "$file" ] || set -- "$@" "$file"
    done
    [ "$#" -eq 0 ] || typos --force-exclude "$@"
    """
  }
  fix = new CommandSpec {
    effect = "write"
    command = """
    set --
    for file in {{files}}; do
      [ ! -e "$file" ] || set -- "$@" "$file"
    done
    [ "$#" -eq 0 ] || typos --force-exclude --write-changes "$@"
    """
  }
}

local checks = new Mapping<String, Step> {
  ["dprint"] = Builtins.dprint

  ["agent-guard-tests"] {
    glob = List("config/agent-guard/*.ts", "config/agent-guard/betterleaks.toml", "config/opencode/plugins/credential-guard.ts")
    check = new CommandSpec {
      command = "bun test config/agent-guard 2>&1"
      effect = "read"
    }
  }

  ["ghostty"] {
    glob = "config/ghostty/**"
    check = new CommandSpec {
      effect = "read"
      command = """
      if command -v ghostty >/dev/null 2>&1; then
        ghostty +validate-config
      elif [ "$(uname -s)" = Darwin ]; then
        /Applications/Ghostty.app/Contents/MacOS/ghostty +validate-config
      else
        ghostty +validate-config
      fi
      """
    }
  }

  ["herdr"] {
    glob = List(
      "config/herdr/config.toml",
      "config/herdr/plugins/**/herdr-plugin.toml"
    )
    check = new CommandSpec { command = "herdr config check"; effect = "read" }
  }

  ["hk-config"] {
    glob = "hk.pkl"
    check = new CommandSpec { command = "hk validate 2>&1"; effect = "read" }
  }

  ["lua"] {
    glob = List(
      "config/nvim/lua/**/*.lua",
      "config/nvim/lua_ls_ci.lua"
    )
    check = new CommandSpec {
      effect = "write"
      command = """
      VIMRUNTIME="$(NVIM_LOG_FILE="${TMPDIR:-/tmp}/nvim-lua-lint.log" nvim --headless --clean --cmd 'lua io.stdout:write(vim.env.VIMRUNTIME)' --cmd qa)" \
        lua-language-server \
          --check config/nvim/lua \
          --checklevel=Warning \
          --configpath="$PWD/config/nvim/lua_ls_ci.lua" \
          --metapath="${TMPDIR:-/tmp}/lua-language-server-meta"
      """
    }
  }

  ["opencode-dependencies"] {
    glob = List(
      "aube-lock.yaml",
      "aube-workspace.yaml",
      "config/opencode/plugins/package.json",
      "config/opencode/tui-plugin/package.json"
    )
    check = new CommandSpec {
      effect = "write"
      command = """
      aube install --frozen-lockfile --dry-run \
        --filter ./config/opencode/plugins \
        --filter ./config/opencode/tui-plugin 2>&1
      """
    }
  }

  ["script-tests"] {
    glob = List(
      "scripts/enrich-release-notes.ts",
      "scripts/enrich-release-notes.test.ts"
    )
    check = new CommandSpec { command = "node --test scripts/*.test.ts 2>&1"; effect = "read" }
  }

  ["hwt-ticket-tests"] {
    glob = List("config/hwt/config.yaml", "config/hwt/close-ticket.sh", "scripts/hwt-close-ticket.test.py")
    check = new CommandSpec { command = "python3 -B scripts/hwt-close-ticket.test.py 2>&1"; effect = "read" }
  }

  ["inline-command-tests"] {
    glob = List(
      "config/inline-command/*.ts",
      "config/agent-guard/core.ts",
      "config/opencode/plugins/inline-command/*.ts",
      "config/opencode/inline-command/*.ts",
      "config/pi/agent/extensions/inline-command.ts"
    )
    check = new CommandSpec {
      command = "bun test config/inline-command config/opencode/inline-command 2>&1"
      effect = "read"
    }
  }

  ["inline-command-install-tests"] {
    glob = List("config/inline-command/install.sh", "config/inline-command/hooks.json", "scripts/inline-command-install.test.py")
    check = new CommandSpec { command = "python3 -B scripts/inline-command-install.test.py 2>&1"; effect = "read" }
  }

  ["herdr-pane-picker-tests"] {
    glob = List("bin/herdr-popup-pane-read", "scripts/herdr-popup-pane-read.test.py")
    check = new CommandSpec { command = "python3 -B scripts/herdr-popup-pane-read.test.py 2>&1"; effect = "read" }
  }

  ["sniff-review-tests"] {
    glob = List(
      "agents/skills/sniff-review/scripts/*.py",
      "agents/skills/sniff-review/references/*.md",
      "scripts/sniff-review.test.py"
    )
    check = new CommandSpec { command = "python3 -B scripts/sniff-review.test.py 2>&1"; effect = "read" }
  }

  ["shellcheck"] = Builtins.shellcheck

  ["taplo"] = (Builtins.taplo) {
    check = new CommandSpec { command = "RUST_LOG=error taplo lint --config .taplo.toml {{files}}"; effect = "read" }
  }

  ["typos"] = typos

  ["yamllint"] = (Builtins.yamllint) {
    check = new CommandSpec { command = "yamllint --strict --config-file ./config/yamllint/config {{files}}"; effect = "read" }
  }
}

hooks {
  ["check"] {
    steps = checks
  }

  ["fix"] {
    fix = true
    steps {
      ["dprint"] = checks["dprint"]
      ["typos"] = checks["typos"]
    }
  }

  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["dprint"] = checks["dprint"]
      ["betterleaks"] {
        // silence INF chatter on stderr; findings log at warn so leaks still surface
        check = new CommandSpec {
          command = "betterleaks git --config betterleaks.toml --pre-commit --redact --staged --verbose --no-banner --log-level warn --validation=false"
          effect = "read"
        }
      }
      ["hk-config"] = checks["hk-config"]
      ["typos"] = checks["typos"]
      ["vim-mode-tests"] {
        glob = List(
          "config/opencode/tui-plugin/vim-mode.tsx",
          "config/opencode/tui-plugin/vim-mode.test.ts"
        )
        check = new CommandSpec {
          command = "bun test config/opencode/tui-plugin/vim-mode.test.ts 2>&1"
          effect = "read"
        }
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commits"] {
        check = new CommandSpec { command = "committed --commit-file {{ commit_msg_file }}"; effect = "read" }
      }
    }
  }

  ["pre-push"] {
    steps = checks
  }
}
