#!/usr/bin/env zsh
source "${0:A:h}/lib"

cwd="$(current_pane_cwd)"
repo_root="$(repo_root_for_cwd "$cwd")"
if [[ -z "$repo_root" ]]; then
  mise x -- gum style --foreground="red" "Not in a git repository"
  exit 1
fi

input="$(mise x -- gum input --placeholder="GitHub PR URL, Graphite PR URL, or branch name...")"
[[ -z "$input" ]] && exit 0

if [[ "$input" =~ '^https://github\.com/([^/]+)/([^/]+)/pull/([0-9]+)([/?#].*)?$' ]]; then
  owner="$match[1]"
  repo="$match[2]"
  pr="$match[3]"
elif [[ "$input" =~ '^https://app\.graphite\.com/github/pr/([^/]+)/([^/]+)/([0-9]+)([/?#].*)?$' ]]; then
  owner="$match[1]"
  repo="$match[2]"
  pr="$match[3]"
elif [[ "$input" == *://* ]]; then
  mise x -- gum style --foreground="red" "Expected a GitHub PR URL, Graphite PR URL, or branch name"
  exit 1
fi

if [[ -n "${pr:-}" ]]; then
  if ! current_repo="$(cd "$repo_root" && gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>&1)"; then
    mise x -- gum style --foreground="red" "$current_repo"
    exit 1
  fi

  if [[ "${(L)current_repo}" != "${(L)owner}/${(L)repo}" ]]; then
    mise x -- gum style --foreground="red" "PR belongs to $owner/$repo, but the current repository is $current_repo"
    exit 1
  fi

  if ! pr_json="$(gh pr view "$pr" --repo "$owner/$repo" --json headRefName 2>&1)"; then
    mise x -- gum style --foreground="red" "$pr_json"
    exit 1
  fi

  branch="$(jq -er '.headRefName' <<<"$pr_json")"
  if ! fetch_output="$(git -C "$repo_root" fetch origin "refs/pull/$pr/head" 2>&1)"; then
    mise x -- gum style --foreground="red" "$fetch_output"
    exit 1
  fi

  base_ref="$(git -C "$repo_root" rev-parse FETCH_HEAD)"
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    existing_ref="$(git -C "$repo_root" rev-parse "refs/heads/$branch")"

    if [[ "$existing_ref" != "$base_ref" ]]; then
      short_oid="$(git -C "$repo_root" rev-parse --short "$base_ref")"
      branch="pr-$pr-$short_oid"
    fi
  fi
else
  branch="$input"

  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    mise x -- gum style --foreground="red" "Invalid branch name: $branch"
    exit 1
  fi

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    base_ref="$branch"
  else
    if ! fetch_output="$(git -C "$repo_root" fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>&1)"; then
      mise x -- gum style --foreground="red" "Could not fetch branch '$branch' from origin: $fetch_output"
      exit 1
    fi

    base_ref="refs/remotes/origin/$branch"
  fi
fi

create_worktree "$repo_root" "$branch" "$base_ref" >/dev/null
