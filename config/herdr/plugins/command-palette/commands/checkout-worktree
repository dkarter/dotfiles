#!/usr/bin/env zsh
source "${0:A:h}/lib"

# Use current tools rather than the Herdr server's inherited versioned PATH.
export PATH="$HOME/.local/share/mise/shims:$PATH"

cwd="$(context_value '.focused_pane_cwd // .workspace_cwd')"
[[ -n "$cwd" ]] || cwd="$(current_pane_cwd)"

input="$(ink input --placeholder="GitHub PR URL, Graphite PR URL, or branch name..." --fullscreen)"
[[ -z "$input" ]] && exit 0

if [[ "$input" =~ '^https://app\.graphite\.com/github/pr/([^/]+)/([^/]+)/([0-9]+)([/?#].*)?$' ]]; then
  input="https://github.com/$match[1]/$match[2]/pull/$match[3]"
fi

exec hwt checkout --cwd "$cwd" --focus -- "$input"
