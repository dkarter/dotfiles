#!/usr/bin/env zsh
source "${0:A:h}/lib"

allow_ticket="${1:-true}"
cwd="$(current_pane_cwd)"

if ! git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
  gum style --foreground="red" "Not in a git repository"
  exit 1
fi

repo_root="$(repo_root_for_cwd "$cwd")"
prompt_worktree "$repo_root" "$allow_ticket" || exit 0

base_branch="$(select_base_branch "$cwd")"
[[ -z "$base_branch" ]] && exit 0

create_worktree "$repo_root" "$worktree_input" "$base_branch" "$worktree_ticket" >/dev/null
