#!/usr/bin/env zsh
source "${0:A:h}/lib"

workspace_id="$(current_workspace_id)"
workspace_json="$(herdr workspace get "$workspace_id")"
checkout_path="$(jq -er '.result.workspace.worktree.checkout_path // empty' <<<"$workspace_json" 2>/dev/null || true)"

if [[ -z "$checkout_path" ]]; then
  checkout_path="$(repo_root_for_cwd "$(current_pane_cwd)")"
fi

if [[ -z "$checkout_path" ]]; then
  mise x -- gum style --foreground="red" "Current workspace pane is not in a git repository"
  exit 1
fi

(cd "$checkout_path" && gh browse)
