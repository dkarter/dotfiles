#!/usr/bin/env zsh
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"
plugin_id="${HERDR_PLUGIN_ID:-dotfiles.command-palette}"

ruby -rjson -rsocket -e '
  socket = UNIXSocket.new(ENV.fetch("HERDR_SOCKET_PATH"))
  socket.puts(JSON.generate(id: "repo_checkout_close_popup", method: "popup.close", params: {}))
  response = JSON.parse(socket.gets)
  error_code = response.dig("error", "code")

  unless response.key?("result") || error_code == "popup_not_open"
    warn(response.to_json)
    exit(1)
  end
'

exec "$herdr_bin" plugin pane open \
  --plugin "$plugin_id" \
  --entrypoint repo-checkout \
  --focus
