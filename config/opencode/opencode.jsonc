{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugin/credential-guard.ts", "./plugin/linear-mcp-sanitize.ts"],
  "mcp": {
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest", "--browser", "webkit"]
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:9090/github/mcp",
      "oauth": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "aubx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"
      ]
    }
  },
  "lsp": {
    "elixir-ls": {
      "disabled": true
    },
    "expert": {
      "command": ["expert", "--stdio"],
      "extensions": [".ex", ".exs", ".heex", ".eex"]
    }
  },
  "permission": {
    "webfetch": "allow",
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "npm run build": "allow",
      "ls": "allow",
      "pwd": "allow",
      "kubectl get secrets": "deny",
      "kubectl get secret": "deny",
      "kubectl get *": "allow",
      "rg *": "allow",
      "rm -rf *": "ask",
      "rm *": "ask",
      "fnox *": "ask",
      "opencode debug config*": "deny",
      "opencode2 debug config*": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "pair": {
      "description": "AI pair programmer that keeps you in the loop by asking for your confirmation before executing any commands and edits",
      "permission": {
        "webfetch": "allow",
        "edit": "ask",
        "bash": {
          "*": "ask",
          "bun run *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git status": "allow",
          "kubectl get *": "allow",
          "kubectl get secret": "deny",
          "kubectl get secrets": "deny",
          "ls": "allow",
          "mix *": "allow",
          "npm run *": "allow",
          "pnpm run *": "allow",
          "pwd": "allow",
          "rg *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "task *": "allow",
          "opencode debug config*": "deny",
          "opencode2 debug config*": "deny"
        }
      }
    }
  },
  "experimental": {}
}
