{
  "plugins": ["./plugins/inline-command"],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp", "--browser", "webkit"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth"
      },
      "github": {
        "type": "remote",
        "url": "http://127.0.0.1:9090/github/mcp",
        "oauth": false
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {}
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["chrome-devtools-mcp", "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"]
      },
      "pitchfork": {
        "type": "local",
        "command": ["pitchfork", "mcp"]
      }
    }
  },
  "lsp": {
    "elixir-ls": {
      "disabled": true
    },
    "expert": {
      "command": ["expert", "--stdio"],
      "extensions": [".ex", ".exs", ".heex", ".eex"]
    }
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "npm run build", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get secrets", "effect": "deny" },
    { "action": "shell", "resource": "kubectl get secret", "effect": "deny" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "fnox *", "effect": "ask" },
    { "action": "shell", "resource": "opencode debug config*", "effect": "deny" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" }
  ],
  "agents": {
    "pair": {
      "description": "AI pair programmer that keeps you in the loop by asking for your confirmation before executing any commands and edits",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "bun run *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl get secret", "effect": "deny" },
        { "action": "shell", "resource": "kubectl get secrets", "effect": "deny" },
        { "action": "shell", "resource": "ls", "effect": "allow" },
        { "action": "shell", "resource": "mix *", "effect": "allow" },
        { "action": "shell", "resource": "npm run *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run *", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "task *", "effect": "allow" },
        { "action": "shell", "resource": "opencode debug config*", "effect": "deny" }
      ]
    }
  },
  "experimental": {}
}
