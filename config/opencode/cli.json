{
  "theme": {
    "name": "opencode-transparent"
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "input.submit": "enter",
    "input.newline": "shift+enter",
    "input.move.left": "left,ctrl+b",
    "session.background": "ctrl+alt+b",
    "session.page.up": "ctrl+alt+u",
    "session.page.down": "ctrl+alt+d",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "plugins": ["./tui-plugin/vim-mode.tsx"],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "layout": "horizontal"
  },
  "attention": {
    "enabled": true,
    "sound": false
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  }
}
