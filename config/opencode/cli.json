{
  "theme": {
    "name": "opencode-transparent"
  },
  "keybinds": {
    "editor_open": "ctrl+g",
    "input_submit": "enter",
    "input_newline": "shift+enter",
    "input_move_left": "left,ctrl+b",
    "session_background": "ctrl+alt+b",
    "messages_page_up": "ctrl+alt+u",
    "messages_page_down": "ctrl+alt+d",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d"
  },
  "plugins": ["./tui-plugin/vim-mode.tsx"],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "layout": "horizontal"
  },
  "attention": {
    "enabled": true,
    "sound": false
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  }
}
